<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="MainController"
      spacing="12"
      alignment="TOP_LEFT"
      prefWidth="440"
      prefHeight="480">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="%language.prompt"/>
        <ComboBox fx:id="languageCombo" onAction="#handleLanguageChange"/>
    </HBox>

    <Label text="%converter.title" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <Label text="%converter.prompt"/>
    <TextField fx:id="inputField" promptText="%converter.prompt"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="%converter.from"/>
        <ComboBox fx:id="sourceCombo"/>
        <Label text="%converter.to"/>
        <ComboBox fx:id="targetCombo"/>
    </HBox>

    <Button fx:id="convertButton" text="%converter.button" onAction="#handleConversion"/>

    <Label fx:id="resultLabel" text="%converter.result.placeholder" style="-fx-font-size: 14px;"/>

    <Label text="%converter.history"/>
    <ListView fx:id="historyView" prefHeight="160"/>
</VBox>
