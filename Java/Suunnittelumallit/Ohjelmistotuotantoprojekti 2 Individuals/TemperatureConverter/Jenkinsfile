// Runs a shell command with sh on Linux/macOS agents and bat on Windows agents.
// Pass windowsCommand when the command reads environment variables, since sh uses $VAR and bat uses %VAR%.
def runCommand(String unixCommand, String windowsCommand = null) {
    if (isUnix()) {
        sh unixCommand
    } else {
        bat(windowsCommand ?: unixCommand)
    }
}

pipeline {
    agent any

    tools {
        // Uses the Maven installation configured in your Jenkins
        maven 'Maven 3.9'
    }

    environment {
        APP_DIR = 'Java/Suunnittelumallit/Ohjelmistotuotantoprojekti 2 Individuals/TemperatureConverter'
        DOCKER_IMAGE = 'veiston/temperature-converter:latest'
        SONARQUBE_SERVER = 'SonarQubeServer'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/veiston/metropolia.git'
            }
        }

        stage('Build') {
            steps {
                dir(APP_DIR) {
                    runCommand('mvn clean install -DskipTests')
                }
            }
        }

        stage('Test') {
            steps {
                dir(APP_DIR) {
                    runCommand('mvn test')
                }
            }
        }

        stage('Code Coverage') {
            steps {
                dir(APP_DIR) {
                    runCommand('mvn jacoco:report')
                }
            }
        }

        stage('Publish Test Results') {
            steps {
                junit '**/target/surefire-reports/*.xml'
            }
        }

        stage('Publish Coverage Report') {
            steps {
                recordCoverage(tools: [[parser: 'JACOCO', pattern: '**/target/site/jacoco/jacoco.xml']])
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir(APP_DIR) {
                    withCredentials([string(credentialsId: 'SONAR_TOKEN', variable: 'SONAR_TOKEN')]) {
                        withSonarQubeEnv("${env.SONARQUBE_SERVER}") {
                            runCommand(
                                'mvn sonar:sonar -Dsonar.projectKey=temperature-converter -Dsonar.token=$SONAR_TOKEN',
                                'mvn sonar:sonar -Dsonar.projectKey=temperature-converter -Dsonar.token=%SONAR_TOKEN%'
                            )
                        }
                    }
                }
            }
        }

        stage('Docker Build and Push') {
            steps {
                dir(APP_DIR) {
                    runCommand("docker build -t ${DOCKER_IMAGE} .")
                    withCredentials([usernamePassword(credentialsId: 'dockerhub', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                        runCommand(
                            'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin',
                            'echo %DOCKER_PASS%| docker login -u %DOCKER_USER% --password-stdin'
                        )
                        runCommand("docker push ${DOCKER_IMAGE}")
                    }
                }
            }
        }
    }

    post {
        always {
            echo 'Pipeline execution finished.'
        }
    }
}
