pipeline {
    agent any

    tools {
        // Uses the Maven installation configured in your Jenkins
        maven 'Maven 3.9'
    }

    environment {
        APP_DIR = 'Java/Suunnittelumallit/Ohjelmistotuotantoprojekti 2 Individuals/TemperatureConverter'
        DOCKER_IMAGE = 'veiston/temperature-converter:latest'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/veiston/metropolia.git'
            }
        }

        stage('Build') {
            steps {
                dir(APP_DIR) {
                    sh 'mvn clean install -DskipTests'
                }
            }
        }

        stage('Test') {
            steps {
                dir(APP_DIR) {
                    sh 'mvn test'
                }
            }
        }

        stage('Code Coverage') {
            steps {
                dir(APP_DIR) {
                    sh 'mvn jacoco:report'
                }
            }
        }

        stage('Publish Test Results') {
            steps {
                junit '**/target/surefire-reports/*.xml'
            }
        }

        stage('Publish Coverage Report') {
            steps {
                recordCoverage(tools: [[parser: 'JACOCO', pattern: '**/target/site/jacoco/jacoco.xml']])
            }
        }

        stage('Docker Build and Push') {
            steps {
                dir(APP_DIR) {
                    sh "docker build -t ${DOCKER_IMAGE} ."
                    withCredentials([usernamePassword(credentialsId: 'dockerhub', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                        sh 'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'
                        sh "docker push ${DOCKER_IMAGE}"
                    }
                }
            }
        }
    }

    post {
        always {
            echo 'Pipeline execution finished.'
        }
    }
}
